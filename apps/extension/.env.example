# Copy this file to apps/extension/.env (copy, do not rename) and fill it in.
# Read at build time and inlined into the extension. Never commit .env or dist/:
# the built extension contains the device token.

# Origin the extension sends tab data to, no trailing slash.
# Real API (pnpm --filter @ai-browser/web dev): http://localhost:3000
# Stand-in receiver, no database needed:        http://localhost:8787 (pnpm --filter @ai-browser/extension stub)
VITE_API_BASE_URL=

# Bearer token identifying this device's user. Any string of at least 8 characters:
# the real API creates the user the first time it sees a token, so pick a long
# random one and keep it (a different token is a different, empty account).
# The stand-in receiver defaults to dev-token.
VITE_DEVICE_TOKEN=
