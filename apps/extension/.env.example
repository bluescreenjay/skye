# Copy this file to apps/extension/.env (copy, do not rename) and fill it in.
# Read at build time and inlined into the extension. Never commit .env or dist/:
# the built extension contains the device token.

# Origin the extension sends tab data to, no trailing slash.
# Local stand-in receiver: http://localhost:8787 (pnpm --filter @ai-browser/extension stub)
VITE_API_BASE_URL=

# Bearer token identifying this device's user. A manually supplied development
# value until feature 003 adds device pairing. The stub receiver defaults to dev-token.
VITE_DEVICE_TOKEN=
