# Copy to .env in the repository root (copy, do not rename) and fill in.
# Never commit .env or real keys.
#
# apps/web reads DATABASE_URL and DEVICE_TOKEN_SECRET (feature 003).
# The Chrome extension has its own file: apps/extension/.env.example.
# The other keys are documented here for later features.

# Postgres connection.
# Preferred: Tiger Data (Timescale Postgres)
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Pivot: Supabase project connection string (keep sslmode=require)
# apps/web adds sslmode=require when the URL has no sslmode, so a local Postgres
# without TLS needs an explicit ?sslmode=disable.
DATABASE_URL=

# Secret used to hash device tokens. Any long random string, kept private and
# stable: changing it makes every existing device token map to a new user.
DEVICE_TOKEN_SECRET=

# AI provider for clustering (feature 004) and chat / actions (later features).
# One provider is active per deployment. Switching is only a change here.
#   LLM_PROVIDER=vt      (default) Virginia Tech ARC LLM API, OpenAI-compatible, models
#                        gpt-oss-120b and friends. Reachable ONLY on the VT Campus VPN, and only
#                        with your own personal VT key (never share it).
#   LLM_PROVIDER=gemini  Google Gemini. The backup: works from any network.
# LLM_PROVIDER=vt

# --- vt provider (default) ---
VT_LLM_API_KEY=
# LLM_BASE_URL=https://llm-api.arc.vt.edu/api/v1
# Model ids. Defaults: gpt-oss-120b-thinking-low for structured work (clustering, commands)
# and for chat (first words in about 0.3 s), gpt-oss-120b for actions. LLM_MODEL overrides all; LLM_MODEL_CLUSTER, _CHAT,
# _ACTIONS, _COMMAND override one purpose. The effort level is part of the id.
# LLM_MODEL=
# LLM_MODEL_CLUSTER=
# The service allows 10 simultaneous requests per model and rejects the rest, so we queue locally
# and keep headroom (default 8 for gpt-oss-120b). Set this to override the local limit.
# LLM_CONCURRENCY=8

# --- gemini provider (backup) ---
GEMINI_API_KEY=
# Default gemini-3.5-flash-lite (free tier: 15 requests a minute, 500 a day). Note: gemini-2.5-flash
# is listed by the API but returns 404 for new users; a listed model is not necessarily callable.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_CLUSTER=
# Thinking effort: minimal (default, fastest) | low | medium | high.
# GEMINI_THINKING_LEVEL=minimal

# --- workspace agents (feature 010) ---
# Agents read a few public pages per run. Each value below is the default; set one only to change it.
# A value that is not a whole number in its allowed range falls back to the default.
# AGENT_MAX_PAGES=8            # pages read per run
# AGENT_PAGE_TIMEOUT_MS=8000   # time one page may take
# AGENT_READ_BUDGET_MS=12000   # time the whole reading step may take
# AGENT_PAGE_BYTES=500000      # bytes read from one page, after decompression
# AGENT_PAGE_CHARS=4000        # characters of text kept from one page
# Agents use the "actions" model (gpt-oss-120b by default): LLM_MODEL_ACTIONS overrides it.

# --- other providers (later; the pivot rule allows one) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Clustering: a group at or above this confidence (0..1) is applied automatically;
# below it, the group becomes a suggestion the user can accept or ignore.
# CLUSTER_CONFIDENCE_BAR=0.7

# Guardrail on model requests per Pacific-time day, shared by all AI features (sized for
# Gemini's free 500/day; the VT API documents no daily cap). In-memory: it resets on restart.
# LLM_DAILY_CAP=450

# Desktop voice (feature 013, optional). Pivot: omit and use the Web Speech API.
ELEVENLABS_API_KEY=
